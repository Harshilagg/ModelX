rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // -------------------- USERS --------------------
    match /users/{userId} {
      allow read, get, list: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null && (
        request.auth.uid == userId ||
        (request.resource.data.connections is list && request.auth.uid in request.resource.data.connections)
      );
    }

    // -------------------- POSTS / COMMENTS --------------------
    match /posts/{postId} {
      allow read: if true;
      allow write: if request.auth != null;
      match /comments/{commentId} {
        allow read: if true;
        allow write: if request.auth != null;
      }
    }

    // -------------------- CHATS / MESSAGES --------------------
    match /chats/{chatId} {
      allow read, write: if request.auth != null && chatId.matches('.*' + request.auth.uid + '.*');
      match /messages/{messageId} {
        allow read, write: if request.auth != null && chatId.matches('.*' + request.auth.uid + '.*');
      }
    }

    match /user_chats/{userId}/chats/{chatId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null && (
        request.auth.uid == userId ||
        request.resource.data.peerId == request.auth.uid
      );
    }

    // -------------------- PORTFOLIO --------------------
    match /portfolio/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // -------------------- CONNECTION REQUESTS --------------------
    match /connection_requests/{requestId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.senderId;
      allow update, delete: if request.auth != null && request.auth.uid == resource.data.receiverId;
    }

    // -------------------- BRANDS --------------------
    match /brands/{brandId} {
      allow read, write: if request.auth != null && request.auth.uid == brandId;
    }

    // -------------------- GIGS + APPLICATIONS --------------------
    match /gigs/{gigId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == resource.data.brandId;
      allow update: if request.auth != null &&
        request.auth.uid != resource.data.brandId &&
        request.resource.data.diff(resource.data).changedKeys().hasOnly(['applicationsCount']);

      match /applications/{modelId} {
        allow create, read: if request.auth != null && request.auth.uid == modelId;
        allow read, update: if request.auth != null && request.auth.uid == get(/databases/$(database)/documents/gigs/$(gigId)).data.brandId;
      }
    }

    // -------------------- AGENCIES --------------------
    match /agency/{agencyId} {
      // Allow the agency owner (docId matches UID) OR any verified member
      allow read, create, update: if request.auth != null && (
        request.auth.uid == agencyId ||
        exists(/databases/$(database)/documents/agency/$(agencyId)/members/$(request.auth.uid))
      );

      // Models/Roster
      match /models/{modelId} {
        allow read: if request.auth != null;
        allow create, update, delete: if request.auth != null && (
          request.auth.uid == agencyId ||
          exists(/databases/$(database)/documents/agency/$(agencyId)/members/$(request.auth.uid))
        );
      }

      // Team Members
      match /members/{memberId} {
        // Members must be able to see each other
        allow read: if request.auth != null && (
          request.auth.uid == agencyId ||
          exists(/databases/$(database)/documents/agency/$(agencyId)/members/$(request.auth.uid))
        );
        // Only the owner can manage the roster
        allow create, update, delete: if request.auth != null && request.auth.uid == agencyId;
      }

      // Activity logs
      match /activity/{activityId} {
        allow read: if request.auth != null && (
          request.auth.uid == agencyId ||
          exists(/databases/$(database)/documents/agency/$(agencyId)/members/$(request.auth.uid))
        );
        allow create: if request.auth != null;
      }

      // Shortlist
      match /shortlist/{modelId} {
        allow read: if request.auth != null && (
          request.auth.uid == agencyId ||
          exists(/databases/$(database)/documents/agency/$(agencyId)/members/$(request.auth.uid))
        );
        allow create, delete: if request.auth != null && request.auth.uid == agencyId;
      }
    }

    // -------------------- CASTINGS --------------------
    match /castings/{castingId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && (
        request.resource.data.agencyId == request.auth.uid ||
        exists(/databases/$(database)/documents/agency/$(request.resource.data.agencyId)/members/$(request.auth.uid))
      );
      allow update, delete: if request.auth != null && (
        request.auth.uid == resource.data.agencyId ||
        exists(/databases/$(database)/documents/agency/$(resource.data.agencyId)/members/$(request.auth.uid))
      );
      allow update: if request.auth != null &&
        request.auth.uid != resource.data.agencyId &&
        request.resource.data.diff(resource.data).changedKeys().hasOnly(['applicationsCount']);

      match /applicants/{applicantId} {
        allow create: if request.auth != null && request.resource.data.modelId == request.auth.uid;
        allow get: if request.auth != null && (
          request.auth.uid == applicantId ||
          (resource.data.modelId == request.auth.uid) ||
          request.auth.uid == get(/databases/$(database)/documents/castings/$(castingId)).data.agencyId
        );
        allow list: if request.auth != null && request.auth.uid == get(/databases/$(database)/documents/castings/$(castingId)).data.agencyId;
        allow update, delete: if request.auth != null && (
          request.auth.uid == get(/databases/$(database)/documents/castings/$(castingId)).data.agencyId ||
          request.auth.uid == resource.data.modelId
        );
      }
    }

    // -------------------- ANNOUNCEMENTS --------------------
    match /announcements/{postId} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.authorId == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.authorId == request.auth.uid;
    }

    // -------------------- AGENCY INVITES --------------------
    match /agencyInvites/{inviteId} {
      // Creation Rule
      allow create: if request.auth != null && (
        request.resource.data.fromAgencyId == request.auth.uid ||
        exists(/databases/$(database)/documents/agency/$(request.resource.data.fromAgencyId)/members/$(request.auth.uid))
      );

      // Read Rule - allow viewing by recipient OR sender OR any existing team member of that agency
      allow read, list: if request.auth != null && (
        request.auth.uid == resource.data.toUid ||
        request.auth.uid == resource.data.fromAgencyId ||
        exists(/databases/$(database)/documents/agency/$(resource.data.fromAgencyId)/members/$(request.auth.uid))
      );

      // Management Rule
      allow delete: if request.auth != null && (
        request.auth.uid == resource.data.toUid ||
        request.auth.uid == resource.data.fromAgencyId
      );

      // Status Update (Accept/Expire)
      allow update: if request.auth != null;
    }

    // -------------------- FALLBACK --------------------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
