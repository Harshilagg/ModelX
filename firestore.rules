rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // -------------------- USERS --------------------
    // User profiles (models and regular users)
    match /users/{userId} {
      // Allow authenticated clients to read profiles and run queries
      allow get, list: if request.auth != null;

      // Create profile: users create their own doc
      allow create: if request.auth != null && request.auth.uid == userId;

      // Update / delete: only profile owner
      allow update, delete: if request.auth != null && request.auth.uid == userId;
    }

    // -------------------- POSTS / COMMENTS --------------------
    match /posts/{postId} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.authorId == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.authorId == request.auth.uid;

      match /comments/{commentId} {
        allow read: if true;
        allow create: if request.auth != null && request.resource.data.authorId == request.auth.uid;
        allow update, delete: if request.auth != null && resource.data.authorId == request.auth.uid;
      }
    }

    // -------------------- CHATS / MESSAGES --------------------
    // Basic pattern: conversations with participants array
    match /conversations/{convId} {
      allow create: if request.auth != null && request.resource.data.participants is list && request.auth.uid in request.resource.data.participants;
      allow read: if request.auth != null && request.auth.uid in resource.data.participants;
      allow update, delete: if request.auth != null && request.auth.uid in resource.data.participants;

      match /messages/{msgId} {
        allow create: if request.auth != null && request.auth.uid == request.resource.data.senderId && request.auth.uid in get(/databases/$(database)/documents/conversations/$(convId)).data.participants;
        allow read: if request.auth != null && request.auth.uid in get(/databases/$(database)/documents/conversations/$(convId)).data.participants;
        allow update, delete: if false; // keep messages immutable for simplicity
      }
    }

    // Legacy per-user chat index (if used elsewhere)
    match /user_chats/{userId}/chats/{chatId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update, delete: if request.auth != null && request.auth.uid == userId;
    }

    // -------------------- PORTFOLIO --------------------
    match /portfolio/{docId} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.ownerId == request.auth.uid;
    }

    // -------------------- CONNECTION REQUESTS --------------------
    match /connection_requests/{requestId} {
      allow read: if request.auth != null && (
        request.auth.uid == resource.data.senderId || request.auth.uid == resource.data.receiverId
      );

      allow create: if request.auth != null && request.auth.uid == request.resource.data.senderId;

      // Receiver may accept/reject (update) and delete
      allow update, delete: if request.auth != null && request.auth.uid == resource.data.receiverId;
    }

    // -------------------- BRANDS --------------------
    match /brands/{brandId} {
      allow get, list: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.ownerId == request.auth.uid;
    }

    // -------------------- GIGS + APPLICATIONS --------------------
    match /gigs/{gigId} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.brandId == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.brandId == request.auth.uid;

      // allow models to increment applicationsCount via update that only changes that field
      allow update: if request.auth != null
        && request.auth.uid != resource.data.brandId
        && request.resource.data.diff(resource.data).changedKeys().hasOnly(['applicationsCount']);

      match /applications/{modelId} {
        allow create: if request.auth != null && request.auth.uid == modelId;
        allow read: if request.auth != null && (request.auth.uid == modelId || request.auth.uid == get(/databases/$(database)/documents/gigs/$(gigId)).data.brandId);
        allow update, delete: if request.auth != null && request.auth.uid == get(/databases/$(database)/documents/gigs/$(gigId)).data.brandId;
      }
    }

    // -------------------- AGENCIES + ROSTER + SHORTLIST --------------------
    match /agency/{agencyId} {
      // allow agencies to read their profile and allow others to read if needed
      allow get, list: if request.auth != null;

      allow create: if request.auth != null && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.ownerId == request.auth.uid;

      // roster subcollection (if used)
      match /models/{modelId} {
        allow read: if request.auth != null;
        allow create, update, delete: if request.auth != null && request.auth.uid == agencyId;
      }

      // shortlist subcollection for agencies to store bookmarked models
      match /shortlist/{modelId} {
        allow read: if request.auth != null && request.auth.uid == agencyId;
        allow create, delete: if request.auth != null && request.auth.uid == agencyId;
      }
    }

    // -------------------- CASTINGS + APPLICANTS --------------------
    match /castings/{castingId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.agencyId == request.auth.uid;
      // Agency owner may update/delete the casting document
      allow update, delete: if request.auth != null && resource.data.agencyId == request.auth.uid;

      // Allow models (non-agency) to only increment `applicationsCount` on a casting
      // This mirrors the gigs rule which permits a single-field increment by applicants.
        allow update: if request.auth != null
          && request.auth.uid != resource.data.agencyId
          && request.resource.data.diff(resource.data).changedKeys().hasOnly(['applicationsCount']);

      match /applicants/{applicantId} {
        // Model may create their own application document (must include modelId matching their uid)
        allow create: if request.auth != null && request.resource.data.modelId == request.auth.uid;

        // Allow the applicant (by path id), the owning agency, or the applicant
        // as indicated by the document's `modelId` field to read applicant docs.
        // This covers both cases where applicant documents were created using the
        // model's UID as the doc id, or where an auto-id was used but the
        // document contains `modelId` pointing to the applicant.
          allow get: if request.auth != null && (
            request.auth.uid == applicantId ||
            request.auth.uid == get(/databases/$(database)/documents/castings/$(castingId)).data.agencyId ||
            (resource.data.modelId == request.auth.uid)
          );

          // Explicitly allow listing of applicants
          allow list: if request.auth != null && request.auth.uid == get(/databases/$(database)/documents/castings/$(castingId)).data.agencyId;

        // Agency can update/delete; applicant (model) can also update/delete their own doc
        allow update, delete: if request.auth != null && (
          request.auth.uid == get(/databases/$(database)/documents/castings/$(castingId)).data.agencyId ||
          request.auth.uid == resource.data.modelId
        );
      }
    }

    // -------------------- ANNOUNCEMENTS --------------------
    match /announcements/{postId} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.authorId == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.authorId == request.auth.uid;
    }

    // -------------------- AGENCY INVITES --------------------
    match /agencyInvites/{inviteId} {
      allow create: if request.auth != null && request.resource.data.fromAgencyId == request.auth.uid;
      allow read: if request.auth != null && (request.auth.uid == resource.data.toUid || request.auth.uid == resource.data.fromAgencyId);
      allow delete: if request.auth != null && (request.auth.uid == resource.data.toUid || request.auth.uid == resource.data.fromAgencyId);
    }

    // -------------------- FALLBACK --------------------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Allow all reads and writes for authenticated users
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
